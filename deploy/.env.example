# 复制为 .env 后生效：install.sh 会自动生成并填好这些值。
# 不要把 .env 提交进 git，也不要发给别人。

# --- 必填：数据库密码与签名密钥（install.sh 用 openssl rand 生成）---
POSTGRES_PASSWORD=change-me-postgres-password
AGENT_SERVER_SECRET=change-me-long-random-secret

# --- 对外访问：公网 IP + 端口 ---
# 轻量服务器防火墙里要放行同一个 TCP 端口。
AGENTS_ANYWHERE_WEB_PORT=18080
AGENT_SERVER_PUBLIC_ORIGIN=http://203.0.113.10:18080
AGENT_SERVER_CORS_ORIGINS=http://203.0.113.10:18080,http://127.0.0.1:18080,http://localhost:18080



# 首次创建管理员用的 setup token 有效期（秒）
AGENT_SERVER_SETUP_TOKEN_TTL=3600

# --- 构建镜像时的软件源（大陆服务器建议保留；境外服务器可以清空）
APT_MIRROR=https://mirrors.ustc.edu.cn/debian
PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple
YARN_REGISTRY=https://registry.npmmirror.com

# Redis 内存上限
REDIS_MAXMEMORY=256mb

# 两人共用，免账号登录；启用前备份，所有访问此地址的人都能进入。
AGENT_SERVER_SHARED_WORKSPACE=false
